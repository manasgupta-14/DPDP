# ===== Backend API (dev + build) =====
# Bina aakhri "/" ke. Yahi ek URL poore app ke API calls ke liye use hota hai.
# Local dev: khaali rakho, requests vite proxy se https://localhost:7139 par jaati hain (vite.config.js)
VITE_API_BASE_URL=

# Backend me GET /api/Breach/my-reports aa jaye tabhi true karo
VITE_BREACH_MY_REPORTS=false
