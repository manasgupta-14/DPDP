{
  "rewrites": [
    {
      "source": "/api/:path((?!translate$).*)",
      "destination": "https://bprmnnz1-7139.inc1.devtunnels.ms/api/:path"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/translate.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}