# ===== Server-only secrets (NO "VITE_" prefix => never shipped to the browser) =====
# Local: copy this file to ".env.local" (already git-ignored by "*.local") and fill values.
# Vercel: Project -> Settings -> Environment Variables (Production + Preview), never commit them.

SARVAM_API_KEY=
# SARVAM_MODEL=sarvam-translate:v1

# Same values as backend appsettings.json -> JwtSettings (SecurityKey / Issuer / Audience).
# With these, signed-in users get higher limits and the proxy verifies your existing login token.
JWT_SECRET=
JWT_ISSUER=localhost:7139
JWT_AUDIENCE=localhost:7139

# true  = public pages (landing/login) can be translated too (strict per-IP limits)
# false = only signed-in users can translate
TRANSLATE_ALLOW_ANONYMOUS=true

# Optional: extra allowed origins (comma separated). Same-host requests are always allowed.
# TRANSLATE_ALLOWED_ORIGINS=https://dpdp-h8dl.vercel.app

# Optional but recommended in production: Upstash Redis (Vercel Marketplace) for shared rate limits
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional limit tuning (per minute)
# TRANSLATE_USER_REQ_PER_MIN=40
# TRANSLATE_USER_CHARS_PER_MIN=30000
# TRANSLATE_ANON_REQ_PER_MIN=20
# TRANSLATE_ANON_CHARS_PER_MIN=10000
