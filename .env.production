# ===== Production build (Vercel) =====
# Khaali: browser same-origin "/api/..." bhejta hai, aur vercel.json ka rewrite use tunnel backend tak pahunchata hai (CORS ki zarurat nahi).
# Vercel dashboard me VITE_API_BASE_URL ho to use DELETE karo, warna wo is file ko override kar dega.
VITE_API_BASE_URL=

VITE_BREACH_MY_REPORTS=false
